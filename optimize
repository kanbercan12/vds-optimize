#!/bin/bash
RED='\033[0;31m';GREEN='\033[0;32m';YELLOW='\033[1;33m';BLUE='\033[0;34m';CYAN='\033[0;36m';WHITE='\033[1;37m';GRAY='\033[0;90m';BOLD='\033[1m';NC='\033[0m'
LOG_FILE="/var/log/vds_optimize.log"
banner(){ clear;echo -e "${CYAN}  ╔═══════════════════════════════════════════════════╗\n  ║         🚀  VDS OPTİMİZASYON ARACI  🚀           ║\n  ║            by optimize · Ubuntu Edition           ║\n  ╚═══════════════════════════════════════════════════╝${NC}"; }
section(){ echo -e "\n${BLUE}  ┌─────────────────────────────────────────┐\n  │${WHITE}  $1${BLUE}$(printf '%*s' $((41-${#1})) '')│\n  └─────────────────────────────────────────┘${NC}"; }
step(){ echo -e "  ${GRAY}├─${NC} ${WHITE}$1${NC}"; }
ok(){ echo -e "  ${GRAY}│  ${GREEN}✔${NC}  $1"; }
skip(){ echo -e "  ${GRAY}│  ${YELLOW}─${NC}  $1 ${GRAY}(atlandı)${NC}"; }
divider(){ echo -e "  ${GRAY}────────────────────────────────────────────${NC}"; }
log(){ echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }
stat_box(){
  du=$(df -h / | awk 'NR==2{print $3}'); df2=$(df -h / | awk 'NR==2{print $4}'); dp=$(df / | awk 'NR==2{print $5}')
  rt=$(free -h | awk '/Mem/{print $2}'); ru=$(free -h | awk '/Mem/{print $3}'); sw=$(free -h | awk '/Swap/{print $3}')
  echo -e "\n  ${CYAN}╔══════════════════════════════════════════════╗"
  echo -e "  ║${WHITE}              SUNUCU DURUMU                   ${CYAN}║"
  echo -e "  ╠══════════════════════════════════════════════╣"
  echo -e "  ║${NC}  💾 Disk : ${GREEN}${du}${NC} kullanıldı / ${GREEN}${df2}${NC} boş ${YELLOW}(${dp})${NC}   ${CYAN}║"
  echo -e "  ║${NC}  🧠 RAM  : ${GREEN}${ru}${NC} / ${GREEN}${rt}${NC}                        ${CYAN}║"
  echo -e "  ║${NC}  🔄 Swap : ${GREEN}${sw}${NC} kullanımda                      ${CYAN}║"
  echo -e "  ║${NC}  🕒 Tarih: ${WHITE}$(date '+%d.%m.%Y %H:%M')${NC}                   ${CYAN}║"
  echo -e "  ╚══════════════════════════════════════════════╝${NC}\n"
}
run_optimize(){
  banner; section "OPTİMİZASYON ÇALIŞIYOR"; log "=== BAŞLADI ==="
  step "APT cache temizleniyor..."; apt-get clean -y >> "$LOG_FILE" 2>&1; apt-get autoclean -y >> "$LOG_FILE" 2>&1; apt-get autoremove -y >> "$LOG_FILE" 2>&1; ok "APT temizlendi"
  step "/tmp temizleniyor..."; find /tmp -type f -atime +1 -delete 2>/dev/null; ok "/tmp temizlendi"
  step "/var/tmp temizleniyor..."; find /var/tmp -type f -atime +3 -delete 2>/dev/null; ok "/var/tmp temizlendi"
  step "Journal logları temizleniyor..."; journalctl --vacuum-size=100M >> "$LOG_FILE" 2>&1; journalctl --vacuum-time=7d >> "$LOG_FILE" 2>&1; ok "Journal temizlendi"
  step "Eski .gz loglar siliniyor..."; find /var/log -name "*.gz" -mtime +30 -delete 2>/dev/null; ok "Eski loglar silindi"
  step "Docker kontrol ediliyor..."; if command -v docker &>/dev/null; then docker system prune -f >> "$LOG_FILE" 2>&1; ok "Docker temizlendi"; else skip "Docker yok"; fi
  step "RAM cache boşaltılıyor..."; sync && echo 3 > /proc/sys/vm/drop_caches; ok "RAM temizlendi"
  step "Swap kontrol ediliyor..."; SW=$(free | awk '/Swap/{print $3}'); if [ "$SW" -gt 0 ]; then swapoff -a && swapon -a >> "$LOG_FILE" 2>&1; ok "Swap temizlendi"; else skip "Swap zaten boş"; fi
  log "=== TAMAMLANDI ==="; divider; echo -e "  ${GREEN}${BOLD}✅  Optimizasyon tamamlandı!${NC}"; divider; stat_box
}
show_logs(){
  banner; section "SON LOGLAR"; echo ""
  if [ -f "$LOG_FILE" ]; then
    tail -40 "$LOG_FILE" | while IFS= read -r l; do echo -e "  ${GRAY}${l}${NC}"; done
  else
    echo -e "  ${YELLOW}⚠  Log yok. Önce: optimize run${NC}"
  fi
  echo ""
}
show_help(){
  banner
  echo -e "  ${WHITE}KULLANIM:${NC}  ${CYAN}optimize ${GRAY}<komut>${NC}\n"
  echo -e "  ${BLUE}  ╔══════════════╦══════════════════════════════════════╗"
  echo -e "  ║${WHITE} Komut        ${BLUE}║${WHITE} Açıklama                             ${BLUE}║"
  echo -e "  ╠══════════════╬══════════════════════════════════════╣"
  echo -e "  ║${GREEN} run          ${BLUE}║${NC} Optimizasyonu hemen çalıştır         ${BLUE}║"
  echo -e "  ║${GREEN} durum        ${BLUE}║${NC} Disk / RAM / Swap göster             ${BLUE}║"
  echo -e "  ║${GREEN} log          ${BLUE}║${NC} Son logları göster                   ${BLUE}║"
  echo -e "  ║${GREEN} logf         ${BLUE}║${NC} Canlı log (Ctrl+C çıkış)             ${BLUE}║"
  echo -e "  ║${GREEN} cron         ${BLUE}║${NC} Otomatik çalışmayı kur               ${BLUE}║"
  echo -e "  ║${GREEN} crondurum    ${BLUE}║${NC} Cron durumunu göster                 ${BLUE}║"
  echo -e "  ║${GREEN} yardım       ${BLUE}║${NC} Bu ekranı göster                     ${BLUE}║"
  echo -e "  ╚══════════════╩══════════════════════════════════════╝${NC}\n"
}
case "${1:-yardım}" in
  run)       run_optimize ;;
  durum)     banner; stat_box ;;
  log)       show_logs ;;
  logf)      banner; section "CANLI LOG"; echo ""; tail -f "$LOG_FILE" ;;
  cron)
    banner; section "CRON KURULUM"; echo ""
    if crontab -l 2>/dev/null | grep -q "optimize run"; then
      echo -e "  ${YELLOW}⚠  Cron zaten kurulu${NC}"
    else
      (crontab -l 2>/dev/null; echo "0 */2 * * * /usr/local/bin/optimize run >> /var/log/vds_optimize.log 2>&1") | crontab -
      echo -e "  ${GREEN}✔  Cron kuruldu — her 2 saatte bir çalışacak${NC}"
    fi
    echo ""
    ;;
  crondurum)
    banner; section "CRON DURUMU"; echo ""
    crontab -l 2>/dev/null | grep -q "optimize run" \
      && echo -e "  ${GREEN}✔  Aktif — 2 saatte bir çalışıyor${NC}" \
      || echo -e "  ${RED}✘  Kurulu değil — 'optimize cron' çalıştır${NC}"
    echo ""
    ;;
  yardım|help|-h|--help|"") show_help ;;
  *) echo -e "\n  ${RED}✘  Bilinmeyen komut: $1${NC}\n  ${GRAY}Yardım için: ${WHITE}optimize yardım${NC}\n"; exit 1 ;;
esac

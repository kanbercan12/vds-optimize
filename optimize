#!/bin/bash
# VDS Optimize - by kanbercan12
RED='\033[0;31m';GREEN='\033[0;32m';YELLOW='\033[1;33m';BLUE='\033[0;34m'
CYAN='\033[0;36m';WHITE='\033[1;37m';GRAY='\033[0;90m';BOLD='\033[1m'
MAGENTA='\033[0;35m';LCYAN='\033[1;36m';LGREEN='\033[1;32m';LRED='\033[1;31m'
DIM='\033[2m';NC='\033[0m'

LOG_FILE="/var/log/vds_optimize.log"
REPO_RAW="https://raw.githubusercontent.com/kanbercan12/vds-optimize/main/optimize"
INSTALL_PATH="/usr/local/bin/optimize"
VERSION="2.0.0"

WIDTH=54

line(){ printf "  ${CYAN}║${NC}"; }
top(){  echo -e "  ${CYAN}╔$(printf '═%.0s' $(seq 1 $WIDTH))╗${NC}"; }
mid(){  echo -e "  ${CYAN}╠$(printf '═%.0s' $(seq 1 $WIDTH))╣${NC}"; }
bot(){  echo -e "  ${CYAN}╚$(printf '═%.0s' $(seq 1 $WIDTH))╝${NC}"; }
thin_top(){ echo -e "  ${GRAY}┌$(printf '─%.0s' $(seq 1 $WIDTH))┐${NC}"; }
thin_mid(){ echo -e "  ${GRAY}├$(printf '─%.0s' $(seq 1 $WIDTH))┤${NC}"; }
thin_bot(){ echo -e "  ${GRAY}└$(printf '─%.0s' $(seq 1 $WIDTH))┘${NC}"; }
pad(){ local t="$1" c="${2:-$WHITE}" w="${3:-$WIDTH}"; local l=${#t}; local s=$(( (w - l) )); printf "${c}%s${NC}%${s}s" "$t" ""; }

banner(){
  clear
  echo ""
  top
  line; printf " %-${WIDTH}s" ""; echo -e "${CYAN}║${NC}"
  line; printf "   ${LCYAN}${BOLD}  ██╗   ██╗██████╗ ███████╗${NC}%$((WIDTH-29))s${CYAN}║${NC}"$'\n'
  line; printf "   ${LCYAN}${BOLD}  ██║   ██║██╔══██╗██╔════╝${NC}%$((WIDTH-29))s${CYAN}║${NC}"$'\n'
  line; printf "   ${LCYAN}${BOLD}  ██║   ██║██║  ██║███████╗${NC}%$((WIDTH-29))s${CYAN}║${NC}"$'\n'
  line; printf "   ${LCYAN}${BOLD}  ╚██╗ ██╔╝██║  ██║╚════██║${NC}%$((WIDTH-29))s${CYAN}║${NC}"$'\n'
  line; printf "   ${LCYAN}${BOLD}   ╚████╔╝ ██████╔╝███████║${NC}%$((WIDTH-29))s${CYAN}║${NC}"$'\n'
  line; printf "   ${LCYAN}${BOLD}    ╚═══╝  ╚═════╝ ╚══════╝${NC}%$((WIDTH-29))s${CYAN}║${NC}"$'\n'
  line; printf " %-${WIDTH}s" ""; echo -e "${CYAN}║${NC}"
  mid
  line; printf "   ${GRAY}VDS Optimizasyon Araci ${DIM}v${VERSION}${NC}%$((WIDTH-26))s${CYAN}║${NC}"$'\n'
  line; printf "   ${GRAY}by ${WHITE}kanbercan12${NC}%$((WIDTH-14))s${CYAN}║${NC}"$'\n'
  bot
  echo ""
}

section(){
  echo ""
  thin_top
  printf "  ${GRAY}│${NC} ${YELLOW}${BOLD}%-$((WIDTH-2))s${NC}${GRAY}│${NC}\n" "$1"
  thin_bot
  echo ""
}

progress_bar(){
  local pct=$1 label="$2" w=30
  local filled=$(( pct * w / 100 ))
  local empty=$(( w - filled ))
  local color=$GREEN
  [ "$pct" -ge 70 ] && color=$YELLOW
  [ "$pct" -ge 90 ] && color=$RED
  printf "  ${GRAY}│${NC}  %-14s ${GRAY}[${NC}${color}%s${GRAY}%s${NC}${GRAY}]${NC} ${WHITE}%3d%%${NC}\n" \
    "$label" "$(printf '█%.0s' $(seq 1 $filled))" "$(printf '░%.0s' $(seq 1 $empty))" "$pct"
}

stat_box(){
  local disk_used disk_total disk_pct ram_used ram_total ram_pct swap_used
  disk_used=$(df / | awk 'NR==2{print $3}')
  disk_total=$(df / | awk 'NR==2{print $2}')
  disk_pct=$(df / | awk 'NR==2{print $5}' | tr -d '%')
  disk_used_h=$(df -h / | awk 'NR==2{print $3}')
  disk_free_h=$(df -h / | awk 'NR==2{print $4}')
  ram_total_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
  ram_avail_kb=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
  ram_used_kb=$(( ram_total_kb - ram_avail_kb ))
  ram_pct=$(( ram_used_kb * 100 / ram_total_kb ))
  ram_used_h=$(free -h | awk '/Mem/{print $3}')
  ram_total_h=$(free -h | awk '/Mem/{print $2}')
  swap_used=$(free -h | awk '/Swap/{print $3}')
  swap_total=$(free -h | awk '/Swap/{print $2}')
  swap_kb=$(free | awk '/Swap/{print $3}')
  swap_total_kb=$(free | awk '/Swap/{print $2}')
  if [ "$swap_total_kb" -gt 0 ]; then
    swap_pct=$(( swap_kb * 100 / swap_total_kb ))
  else
    swap_pct=0
  fi
  uptime_str=$(uptime -p 2>/dev/null || uptime | awk -F'up ' '{print $2}' | awk -F',' '{print $1}')
  load=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | tr -d ',')

  echo ""
  thin_top
  printf "  ${GRAY}│${NC} ${CYAN}${BOLD}%-$((WIDTH-2))s${NC}${GRAY}│${NC}\n" "  SUNUCU DURUMU"
  thin_mid
  printf "  ${GRAY}│${NC}%-${WIDTH}s${GRAY}│${NC}\n" ""
  progress_bar "$disk_pct" "💾 Disk"
  printf "  ${GRAY}│${NC}  ${DIM}%-$((WIDTH-3))s${NC}${GRAY}│${NC}\n" "${disk_used_h} kullanıldı / ${disk_free_h} boş"
  printf "  ${GRAY}│${NC}%-${WIDTH}s${GRAY}│${NC}\n" ""
  progress_bar "$ram_pct" "🧠 RAM"
  printf "  ${GRAY}│${NC}  ${DIM}%-$((WIDTH-3))s${NC}${GRAY}│${NC}\n" "${ram_used_h} / ${ram_total_h}"
  printf "  ${GRAY}│${NC}%-${WIDTH}s${GRAY}│${NC}\n" ""
  progress_bar "$swap_pct" "🔄 Swap"
  printf "  ${GRAY}│${NC}  ${DIM}%-$((WIDTH-3))s${NC}${GRAY}│${NC}\n" "${swap_used} / ${swap_total}"
  printf "  ${GRAY}│${NC}%-${WIDTH}s${GRAY}│${NC}\n" ""
  printf "  ${GRAY}│${NC}  ${GRAY}⏱  Uptime:${NC} ${WHITE}%-$((WIDTH-13))s${NC}${GRAY}│${NC}\n" "$uptime_str"
  printf "  ${GRAY}│${NC}  ${GRAY}📊 Load:  ${NC} ${WHITE}%-$((WIDTH-13))s${NC}${GRAY}│${NC}\n" "$load"
  printf "  ${GRAY}│${NC}  ${GRAY}🕒 Tarih: ${NC} ${WHITE}%-$((WIDTH-13))s${NC}${GRAY}│${NC}\n" "$(date '+%d.%m.%Y %H:%M')"
  printf "  ${GRAY}│${NC}%-${WIDTH}s${GRAY}│${NC}\n" ""
  thin_bot
  echo ""
}

spinner(){
  local pid=$1 msg="$2" i=0
  local sp=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏')
  while kill -0 "$pid" 2>/dev/null; do
    printf "\r  ${CYAN}${sp[$i]}${NC}  ${WHITE}%s${NC}  " "$msg"
    i=$(( (i+1) % 10 ))
    sleep 0.1
  done
  printf "\r"
}

step_run(){
  local msg="$1"; shift
  printf "  ${GRAY}├─${NC} ${WHITE}%s${NC}" "$msg"
  ("$@" >> "$LOG_FILE" 2>&1) &
  local pid=$!
  local sp=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏') i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf "\r  ${CYAN}${sp[$i]}${NC}  ${WHITE}%-45s${NC}" "$msg"
    i=$(( (i+1) % 10 ))
    sleep 0.08
  done
  wait "$pid"
  local ec=$?
  if [ $ec -eq 0 ]; then
    printf "\r  ${GREEN}✔${NC}  ${WHITE}%-45s${NC}\n" "$msg"
  else
    printf "\r  ${RED}✘${NC}  ${WHITE}%-45s${NC}\n" "$msg"
  fi
  return $ec
}

log(){ echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }

run_optimize(){
  banner; section "⚡ OPTİMİZASYON"; log "=== BASALDI ==="
  step_run "APT cache temizleniyor"    bash -c "apt-get clean -y && apt-get autoclean -y && apt-get autoremove -y"
  step_run "/tmp temizleniyor"         bash -c "find /tmp -type f -atime +1 -delete 2>/dev/null; true"
  step_run "/var/tmp temizleniyor"     bash -c "find /var/tmp -type f -atime +3 -delete 2>/dev/null; true"
  step_run "Journal logları kırpılıyor" bash -c "journalctl --vacuum-size=100M && journalctl --vacuum-time=7d"
  step_run "Eski .gz loglar siliniyor" bash -c "find /var/log -name '*.gz' -mtime +30 -delete 2>/dev/null; true"
  if command -v docker &>/dev/null; then
    step_run "Docker temizleniyor"     bash -c "docker system prune -f"
  else
    printf "  ${GRAY}─${NC}  ${DIM}Docker yok — atlandı${NC}\n"
  fi
  step_run "RAM cache boşaltılıyor"   bash -c "sync && echo 3 > /proc/sys/vm/drop_caches"
  SW=$(free | awk '/Swap/{print $3}')
  if [ "$SW" -gt 0 ]; then
    step_run "Swap temizleniyor"      bash -c "swapoff -a && swapon -a"
  else
    printf "  ${GRAY}─${NC}  ${DIM}Swap zaten boş — atlandı${NC}\n"
  fi
  log "=== TAMAMLANDI ==="
  echo ""
  echo -e "  ${LGREEN}${BOLD}✅  Optimizasyon tamamlandı!${NC}"
  stat_box
}

show_logs(){
  banner; section "📋 SON LOGLAR"
  if [ -f "$LOG_FILE" ]; then
    tail -40 "$LOG_FILE" | while IFS= read -r l; do
      printf "  ${GRAY}%s${NC}\n" "$l"
    done
  else
    echo -e "  ${YELLOW}⚠  Log yok. Önce: optimize run${NC}"
  fi
  echo ""
}

do_upgrade(){
  banner; section "🔄 GÜNCELLEME"
  printf "  ${GRAY}├─${NC} ${WHITE}GitHub'dan indiriliyor...${NC}"
  TMP=$(mktemp)
  if curl -fsSL "$REPO_RAW" -o "$TMP" 2>/dev/null; then
    cp "$TMP" "$INSTALL_PATH" && chmod +x "$INSTALL_PATH" && rm -f "$TMP"
    printf "\r  ${GREEN}✔${NC}  ${WHITE}Güncelleme tamamlandı! %-25s${NC}\n" ""
    printf "  ${GRAY}│  Sürüm: ${WHITE}%s → ${LGREEN}%s${NC}\n" "$VERSION" "$(bash $INSTALL_PATH --version 2>/dev/null || echo 'yeni')"
  else
    rm -f "$TMP"
    printf "\r  ${RED}✘${NC}  ${LRED}İndirme başarısız!${NC}\n"
    exit 1
  fi
  echo ""
}

show_help(){
  banner
  section "📖 KULLANIM"
  printf "  ${GRAY}│${NC}  ${WHITE}optimize ${CYAN}<komut>${NC}\n\n"
  printf "  ${GRAY}│${NC}  ${YELLOW}%-14s${NC}  %s\n" "run"       "Optimizasyonu çalıştır"
  printf "  ${GRAY}│${NC}  ${YELLOW}%-14s${NC}  %s\n" "durum"     "Disk / RAM / Swap durumu"
  printf "  ${GRAY}│${NC}  ${YELLOW}%-14s${NC}  %s\n" "log"       "Son logları göster"
  printf "  ${GRAY}│${NC}  ${YELLOW}%-14s${NC}  %s\n" "logf"      "Canlı log (Ctrl+C çıkış)"
  printf "  ${GRAY}│${NC}  ${YELLOW}%-14s${NC}  %s\n" "cron"      "Otomatik çalışmayı kur"
  printf "  ${GRAY}│${NC}  ${YELLOW}%-14s${NC}  %s\n" "crondurum" "Cron durumunu göster"
  printf "  ${GRAY}│${NC}  ${YELLOW}%-14s${NC}  %s\n" "upgrade"   "GitHub'dan son sürümü yükle"
  printf "  ${GRAY}│${NC}  ${YELLOW}%-14s${NC}  %s\n" "yardım"    "Bu ekranı göster"
  echo ""
}

case "${1:-yardım}" in
  run)        run_optimize ;;
  durum)      banner; stat_box ;;
  log)        show_logs ;;
  logf)       banner; section "📡 CANLI LOG"; echo ""; tail -f "$LOG_FILE" ;;
  upgrade)    do_upgrade ;;
  --version)  echo "$VERSION" ;;
  cron)
    banner; section "⏰ CRON KURULUM"; echo ""
    if crontab -l 2>/dev/null | grep -q "optimize run"; then
      printf "  ${YELLOW}⚠  Cron zaten kurulu${NC}\n"
    else
      (crontab -l 2>/dev/null; echo "0 */2 * * * /usr/local/bin/optimize run >> /var/log/vds_optimize.log 2>&1") | crontab -
      printf "  ${GREEN}✔  Cron kuruldu — her 2 saatte bir çalışacak${NC}\n"
    fi
    echo ""
    ;;
  crondurum)
    banner; section "⏰ CRON DURUMU"; echo ""
    crontab -l 2>/dev/null | grep -q "optimize run" \
      && printf "  ${GREEN}✔  Aktif — 2 saatte bir çalışıyor${NC}\n" \
      || printf "  ${RED}✘  Kurulu değil — 'optimize cron' çalıştır${NC}\n"
    echo ""
    ;;
  yardım|help|-h|--help|"") show_help ;;
  *) printf "\n  ${RED}✘  Bilinmeyen komut: %s${NC}\n  ${GRAY}Yardım için: ${WHITE}optimize yardım${NC}\n\n" "$1"; exit 1 ;;
esac

#!/bin/bash
# VDS Optimize - by kanbercan12
G='\033[1;32m'; R='\033[1;31m'; Y='\033[1;33m'; C='\033[1;36m'
W='\033[1;37m'; D='\033[0;90m'; N='\033[0m'

LOG_FILE="/var/log/vds_optimize.log"
REPO_RAW="https://raw.githubusercontent.com/kanbercan12/vds-optimize/main/optimize"
INSTALL_PATH="/usr/local/bin/optimize"
TUI_PATH="/usr/local/lib/optimize_tui.py"
VERSION="3.1.0"

log(){ echo "[$(date '+%Y-%m-%d %H:%M:%S')] $1" >> "$LOG_FILE"; }

_install_tui(){
cat > "$TUI_PATH" << 'PYEOF'
#!/usr/bin/env python3
# VDS Optimize TUI - by kanbercan12
import curses, subprocess, threading, time, os, re
from datetime import datetime

VERSION = "3.1.0"
LOG_FILE = "/var/log/vds_optimize.log"

MENU = [
    ("1", "Optimize çalıştır"),
    ("2", "Durum göster"),
    ("3", "Son loglar"),
    ("4", "Canlı log"),
    None,
    ("5", "Cron kur"),
    ("6", "Cron durumu"),
    None,
    ("7", "Upgrade"),
    None,
    ("q", "Çıkış"),
]

def run(cmd):
    r = subprocess.run(cmd, shell=True, capture_output=True, text=True)
    return r.stdout.strip()

def get_stats():
    disk = run("df / | awk 'NR==2{print $5,$3,$4}'").split()
    disk_pct = int(disk[0].rstrip('%')) if disk else 0
    disk_used = disk[1] if len(disk) > 1 else "?"
    disk_free = disk[2] if len(disk) > 2 else "?"
    mem = run("free -h | awk '/Mem/{print $3,$2}'").split()
    ram_used = mem[0] if mem else "?"
    ram_total = mem[1] if len(mem) > 1 else "?"
    mem_kb = run("free | awk '/Mem/{print $2,$3}'").split()
    ram_pct = int(int(mem_kb[1])*100//int(mem_kb[0])) if len(mem_kb)==2 and int(mem_kb[0])>0 else 0
    swap_kb = run("free | awk '/Swap/{print $2,$3}'").split()
    swap_pct = int(int(swap_kb[1])*100//int(swap_kb[0])) if len(swap_kb)==2 and int(swap_kb[0])>0 else 0
    swap_used = run("free -h | awk '/Swap/{print $3}'")
    swap_total = run("free -h | awk '/Swap/{print $2}'")
    load = run("uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | tr -d ','")
    uptime_s = run("uptime -p 2>/dev/null || uptime | awk -F'up ' '{print $2}' | awk -F',' '{print $1}'")
    return {
        "disk_pct": disk_pct, "disk_used": disk_used, "disk_free": disk_free,
        "ram_pct": ram_pct, "ram_used": ram_used, "ram_total": ram_total,
        "swap_pct": swap_pct, "swap_used": swap_used, "swap_total": swap_total,
        "load": load, "uptime": uptime_s,
    }

def pct_bar(pct, w=10):
    filled = int(pct * w // 100)
    return "█" * filled + "░" * (w - filled)

def strip_ansi(s):
    return re.sub(r'\x1b\[[0-9;]*m', '', s)

class OptimizeTUI:
    def __init__(self, scr):
        self.scr = scr
        self.sel = 0
        self.selectable = [i for i, m in enumerate(MENU) if m]
        self.output_lines = []
        self.output_lock = threading.Lock()
        self.running_cmd = False
        self.live_log = False
        self.stats = {}
        self.stats_lock = threading.Lock()
        self._init_colors()
        self._load_stats()

    def _init_colors(self):
        curses.start_color()
        curses.use_default_colors()
        curses.init_pair(1, curses.COLOR_CYAN,  -1)
        curses.init_pair(2, curses.COLOR_GREEN, -1)
        curses.init_pair(3, curses.COLOR_RED,   -1)
        curses.init_pair(4, curses.COLOR_YELLOW,-1)
        curses.init_pair(5, curses.COLOR_WHITE, -1)
        curses.init_pair(6, 8,                  -1)
        curses.init_pair(7, curses.COLOR_BLACK, curses.COLOR_CYAN)
        curses.init_pair(8, curses.COLOR_BLACK, curses.COLOR_GREEN)

    def _load_stats(self):
        def _do():
            s = get_stats()
            with self.stats_lock:
                self.stats = s
        threading.Thread(target=_do, daemon=True).start()

    def draw(self):
        self.scr.erase()
        h, w = self.scr.getmaxyx()
        menu_w = 24
        cx = menu_w + 1

        with self.stats_lock:
            st = dict(self.stats)

        # header
        title = " VDS OPTİMİZASYON  ·  sunucu yönetimi"
        ts = datetime.now().strftime("%d.%m.%Y %H:%M:%S")
        hdr = title + " " * max(0, w - len(title) - len(ts) - 1) + ts
        try:
            self.scr.attron(curses.color_pair(1) | curses.A_BOLD)
            self.scr.addstr(0, 0, hdr[:w])
            self.scr.attroff(curses.color_pair(1) | curses.A_BOLD)
        except curses.error:
            pass

        # stat bar
        if st:
            dp = st.get("disk_pct", 0)
            rp = st.get("ram_pct", 0)
            sp = st.get("swap_pct", 0)
            lo = st.get("load", "?")
            dc = curses.color_pair(3 if dp >= 90 else 4 if dp >= 70 else 2)
            rc = curses.color_pair(3 if rp >= 90 else 4 if rp >= 70 else 2)
            sc = curses.color_pair(3 if sp >= 70 else 2)
            parts = [
                (" Disk ", None), (pct_bar(dp, 8), dc), (f" {dp}%  ", curses.color_pair(5)),
                ("RAM ", None),  (pct_bar(rp, 8), rc), (f" {rp}%  ", curses.color_pair(5)),
                ("Swap ", None), ((pct_bar(sp,6)+f" {sp}%") if sp>0 else "bos", sc if sp>0 else curses.color_pair(6)),
                (f"  Yuk {lo}", curses.color_pair(5)),
            ]
            x = 0
            for text, attr in parts:
                if x >= w: break
                chunk = text[:w - x]
                try:
                    if attr: self.scr.attron(attr)
                    self.scr.addstr(1, x, chunk)
                    if attr: self.scr.attroff(attr)
                    x += len(chunk)
                except curses.error:
                    pass

        # divider
        try:
            self.scr.attron(curses.color_pair(6))
            self.scr.addstr(2, 0, "─"*menu_w + "┬" + "─"*max(0,w-menu_w-1))
            self.scr.attroff(curses.color_pair(6))
        except curses.error:
            pass

        # labels
        try:
            self.scr.attron(curses.color_pair(5)|curses.A_BOLD)
            self.scr.addstr(3, 1, " MENÜ")
            lbl = " ÇIKTI" if self.running_cmd else " DURUM"
            self.scr.addstr(3, cx, lbl)
            self.scr.attroff(curses.color_pair(5)|curses.A_BOLD)
        except curses.error:
            pass

        # vertical separator
        for row in range(2, h-1):
            try:
                self.scr.attron(curses.color_pair(6))
                self.scr.addstr(row, menu_w, "│")
                self.scr.attroff(curses.color_pair(6))
            except curses.error:
                pass

        # menu
        sel_i = self.selectable[self.sel]
        row = 4
        for i, item in enumerate(MENU):
            if row >= h-1: break
            if item is None:
                row += 1; continue
            key, label = item
            is_sel = (i == sel_i)
            text = f" {key} {label}"[:menu_w-1].ljust(menu_w-1)
            try:
                if is_sel:
                    self.scr.attron(curses.color_pair(7)|curses.A_BOLD)
                    self.scr.addstr(row, 0, text)
                    self.scr.attroff(curses.color_pair(7)|curses.A_BOLD)
                else:
                    self.scr.attron(curses.color_pair(1)|curses.A_BOLD)
                    self.scr.addstr(row, 1, key)
                    self.scr.attroff(curses.color_pair(1)|curses.A_BOLD)
                    self.scr.attron(curses.color_pair(5))
                    self.scr.addstr(row, 2, f" {label}"[:menu_w-2])
                    self.scr.attroff(curses.color_pair(5))
            except curses.error:
                pass
            row += 1

        # content
        content_w = max(0, w - cx - 1)
        content_h = h - 5
        with self.output_lock:
            lines = list(self.output_lines)
        if not lines and not self.running_cmd and st:
            lines = self._stat_lines(st)
        visible = lines[-content_h:] if len(lines) > content_h else lines
        for ri, line in enumerate(visible):
            if 4+ri >= h-1: break
            stripped = strip_ansi(line)[:content_w]
            color = curses.color_pair(5)
            sl = stripped.strip()
            if sl.startswith("✔") or "tamamlandi" in sl.lower() or "tamam" in sl.lower():
                color = curses.color_pair(2)
            elif sl.startswith("✘") or "basarisiz" in sl.lower():
                color = curses.color_pair(3)
            elif sl.startswith("─") or sl.startswith("["):
                color = curses.color_pair(6)
            elif sl.startswith("…") or sl.startswith("Baslatiliyor"):
                color = curses.color_pair(4)
            try:
                self.scr.attron(color)
                self.scr.addstr(4+ri, cx, stripped)
                self.scr.attroff(color)
            except curses.error:
                pass

        # footer
        footer = " ↑↓ seç · ENTER/1-7 çalıştır · R yenile · Q çıkış"
        try:
            self.scr.attron(curses.color_pair(1))
            self.scr.addstr(h-1, 0, footer[:w-1].ljust(w-1))
            self.scr.attroff(curses.color_pair(1))
        except curses.error:
            pass

        self.scr.refresh()

    def _stat_lines(self, st):
        dp = st.get("disk_pct",0); rp = st.get("ram_pct",0); sp = st.get("swap_pct",0)
        lines = ["",
            f"  Disk    : {dp}%  ({st.get('disk_used','?')} kullanialdi, {st.get('disk_free','?')} bos)",
            f"  RAM     : {rp}%  ({st.get('ram_used','?')} / {st.get('ram_total','?')})",
            f"  Swap    : {sp}%  ({st.get('swap_used','?')} / {st.get('swap_total','?')})" if sp>0 else "  Swap    : bos",
            f"  Yuk     : {st.get('load','?')}",
            f"  Uptime  : {st.get('uptime','?')}",
            "",
        ]
        cron_active = os.popen("crontab -l 2>/dev/null | grep -c 'optimize run'").read().strip() != "0"
        lines.append(f"  Cron    : {'aktif - her 2 saatte bir' if cron_active else 'kurulu degil'}")
        lines.append(f"  Versiyon: v{VERSION}")
        return lines

    def set_output(self, lines):
        with self.output_lock:
            self.output_lines = list(lines)

    def append_output(self, line):
        with self.output_lock:
            self.output_lines.append(line)

    def run_action(self, action):
        if self.running_cmd: return
        self.running_cmd = True
        self.set_output([])
        def _run():
            try:
                if action == "logf":
                    self.live_log = True
                    import subprocess as sp2
                    proc = sp2.Popen(["tail","-n","40","-f",LOG_FILE],
                                     stdout=sp2.PIPE, stderr=sp2.PIPE, text=True)
                    while self.live_log:
                        line = proc.stdout.readline()
                        if not line: break
                        self.append_output("  " + strip_ansi(line.rstrip()))
                    proc.terminate()
                else:
                    import subprocess as sp2
                    proc = sp2.Popen(["/usr/local/bin/optimize", action],
                                     stdout=sp2.PIPE, stderr=sp2.STDOUT, text=True)
                    for line in proc.stdout:
                        self.append_output(strip_ansi(line.rstrip()))
                    proc.wait()
            finally:
                self.running_cmd = False
                self.live_log = False
                self._load_stats()
        threading.Thread(target=_run, daemon=True).start()

    def handle_key(self, k):
        km = {ord('1'):"run", ord('2'):"durum", ord('3'):"log",
              ord('4'):"logf", ord('5'):"cron", ord('6'):"crondurum", ord('7'):"upgrade"}
        if self.live_log and k != curses.ERR:
            self.live_log = False; return True
        if k in (curses.KEY_UP, ord('k')):
            self.sel = (self.sel-1) % len(self.selectable)
        elif k in (curses.KEY_DOWN, ord('j')):
            self.sel = (self.sel+1) % len(self.selectable)
        elif k in (curses.KEY_ENTER, ord('\n'), ord('\r')):
            idx = self.selectable[self.sel]
            item = MENU[idx]
            if item:
                am = {"1":"run","2":"durum","3":"log","4":"logf","5":"cron","6":"crondurum","7":"upgrade","q":None}
                action = am.get(item[0])
                if action is None: return False
                self.run_action(action)
        elif k in km:
            self.run_action(km[k])
        elif k in (ord('q'), ord('Q')):
            return False
        elif k in (ord('r'), ord('R')):
            self._load_stats(); self.set_output([])
        return True

    def run(self):
        self.scr.nodelay(True); self.scr.keypad(True); curses.curs_set(0)
        tick = 0
        while True:
            self.draw()
            k = self.scr.getch()
            if k != curses.ERR:
                if not self.handle_key(k): break
            time.sleep(0.05)
            tick += 1
            if tick % 400 == 0:
                self._load_stats()

def main(scr):
    OptimizeTUI(scr).run()

if __name__ == "__main__":
    curses.wrapper(main)
PYEOF
chmod +x "$TUI_PATH"
}

stat_line(){
  disk_pct=$(df / | awk 'NR==2{print $5}' | tr -d '%')
  disk_used=$(df -h / | awk 'NR==2{print $3}')
  disk_free=$(df -h / | awk 'NR==2{print $4}')
  ram_used=$(free -h | awk '/Mem/{print $3}')
  ram_total=$(free -h | awk '/Mem/{print $2}')
  ram_total_kb=$(grep MemTotal /proc/meminfo | awk '{print $2}')
  ram_avail_kb=$(grep MemAvailable /proc/meminfo | awk '{print $2}')
  ram_pct=$(( (ram_total_kb - ram_avail_kb) * 100 / ram_total_kb ))
  swap_kb=$(free | awk '/Swap/{print $3}')
  swap_total_kb=$(free | awk '/Swap/{print $2}')
  swap_pct=$(( swap_total_kb > 0 ? swap_kb * 100 / swap_total_kb : 0 ))
  swap_used=$(free -h | awk '/Swap/{print $3}')
  swap_total=$(free -h | awk '/Swap/{print $2}')
  load=$(uptime | awk -F'load average:' '{print $2}' | awk '{print $1}' | tr -d ',')
  local dc=$G; [ "$disk_pct" -ge 70 ] && dc=$Y; [ "$disk_pct" -ge 90 ] && dc=$R
  local rc=$G; [ "$ram_pct"  -ge 70 ] && rc=$Y; [ "$ram_pct"  -ge 90 ] && rc=$R
  echo ""
  printf "  ${D}Disk    :${N} ${dc}%s%%${N}  ${D}(%s kullanıldı, %s boş)${N}\n" "$disk_pct" "$disk_used" "$disk_free"
  printf "  ${D}RAM     :${N} ${rc}%s%%${N}  ${D}(%s / %s)${N}\n" "$ram_pct" "$ram_used" "$ram_total"
  if [ "$swap_total_kb" -gt 0 ] && [ "$swap_kb" -gt 0 ]; then
    printf "  ${D}Swap    :${N} %s / %s\n" "$swap_used" "$swap_total"
  else
    printf "  ${D}Swap    :${N} ${D}boş${N}\n"
  fi
  printf "  ${D}Load    :${N} %s  ${D}·  %s${N}\n" "$load" "$(date '+%d.%m.%Y %H:%M')"
  echo ""
}

step_ok(){   printf "  ${G}✔${N}  %s\n" "$1"; }
step_err(){  printf "  ${R}✘${N}  %s\n" "$1"; }
step_skip(){ printf "  ${D}─${N}  ${D}%s${N}\n" "$1"; }

step_run(){
  local msg="$1"; shift
  printf "  ${D}…${N}  %s" "$msg"
  ("$@" >> "$LOG_FILE" 2>&1) &
  local pid=$! sp=('⠋' '⠙' '⠹' '⠸' '⠼' '⠴' '⠦' '⠧' '⠇' '⠏') i=0
  while kill -0 "$pid" 2>/dev/null; do
    printf "\r  ${C}%s${N}  %s" "${sp[$i]}" "$msg"
    i=$(( (i+1) % 10 )); sleep 0.08
  done
  wait "$pid"; local ec=$?
  if [ $ec -eq 0 ]; then printf "\r"; step_ok "$msg"
  else                   printf "\r"; step_err "$msg"; fi
  return $ec
}

run_optimize(){
  echo ""
  printf "  ${Y}Optimizasyon başlıyor...${N}\n\n"
  log "=== BASALDI ==="
  step_run "APT cache temizleniyor"     bash -c "apt-get clean -y && apt-get autoclean -y && apt-get autoremove -y"
  step_run "/tmp temizleniyor"          bash -c "find /tmp -type f -atime +1 -delete 2>/dev/null; true"
  step_run "/var/tmp temizleniyor"      bash -c "find /var/tmp -type f -atime +3 -delete 2>/dev/null; true"
  step_run "Journal logları kırpılıyor" bash -c "journalctl --vacuum-size=100M && journalctl --vacuum-time=7d"
  step_run "Eski .gz loglar siliniyor"  bash -c "find /var/log -name '*.gz' -mtime +30 -delete 2>/dev/null; true"
  if command -v docker &>/dev/null; then
    step_run "Docker temizleniyor"      bash -c "docker system prune -f"
  else
    step_skip "Docker yok — atlandı"
  fi
  step_run "RAM cache boşaltılıyor"    bash -c "sync && echo 3 > /proc/sys/vm/drop_caches"
  if [ "$(free | awk '/Swap/{print $3}')" -gt 0 ]; then
    step_run "Swap temizleniyor"       bash -c "swapoff -a && swapon -a"
  else
    step_skip "Swap zaten boş — atlandı"
  fi
  log "=== TAMAMLANDI ==="
  echo ""
  printf "  ${G}✔  Optimizasyon tamamlandı!${N}\n"
  stat_line
}

show_logs(){
  echo ""
  if [ -f "$LOG_FILE" ]; then
    tail -40 "$LOG_FILE" | while IFS= read -r l; do printf "  ${D}%s${N}\n" "$l"; done
  else
    printf "  ${Y}Log yok. Önce: optimize run${N}\n"
  fi
  echo ""
}

do_upgrade(){
  echo ""
  printf "  ${D}…${N}  GitHub'dan indiriliyor..."
  TMP=$(mktemp)
  if curl -fsSL "$REPO_RAW" -o "$TMP" 2>/dev/null; then
    NEW_VER=$(grep '^VERSION=' "$TMP" | cut -d'"' -f2)
    cp "$TMP" "$INSTALL_PATH" && chmod +x "$INSTALL_PATH" && rm -f "$TMP"
    printf "\r  ${G}✔${N}  Güncelleme tamamlandı!  ${D}%s → %s${N}\n\n" "$VERSION" "${NEW_VER:-yeni}"
    exec "$INSTALL_PATH" "$@"
  else
    rm -f "$TMP"
    printf "\r  ${R}✘${N}  İndirme başarısız!\n\n"
    exit 1
  fi
}

run_cron(){
  echo ""
  if crontab -l 2>/dev/null | grep -q "optimize run"; then
    printf "  ${Y}Cron zaten kurulu — her 2 saatte bir çalışıyor${N}\n"
  else
    (crontab -l 2>/dev/null; echo "0 */2 * * * /usr/local/bin/optimize run >> /var/log/vds_optimize.log 2>&1") | crontab -
    printf "  ${G}✔  Cron kuruldu — her 2 saatte bir çalışacak${N}\n"
  fi
  echo ""
}

run_crondurum(){
  echo ""
  if crontab -l 2>/dev/null | grep -q "optimize run"; then
    printf "  ${G}✔  Aktif — 2 saatte bir çalışıyor${N}\n"
  else
    printf "  ${R}✘  Kurulu değil — başlatmak için: optimize cron${N}\n"
  fi
  echo ""
}

dispatch(){
  case "$1" in
    run)        run_optimize ;;
    durum)      stat_line ;;
    log)        show_logs ;;
    logf)       printf "\n  ${C}Canlı log (çıkmak: CTRL+C)${N}\n\n"; tail -f "$LOG_FILE" ;;
    upgrade)    do_upgrade ;;
    cron)       run_cron ;;
    crondurum)  run_crondurum ;;
    yardim|yardım|help|-h|--help)
      echo ""
      printf "  ${D}Komutlar :${N} run | durum | log | logf | cron | crondurum | upgrade\n"
      printf "  ${D}TUI      :${N} optimize  (argümansız)\n\n" ;;
    --version)  echo "$VERSION" ;;
    *) printf "\n  ${R}✘  Bilinmeyen komut: %s${N}\n  ${D}Yardım: optimize yardim${N}\n\n" "$1" ;;
  esac
}

if [ $# -eq 0 ]; then
  if [ -t 0 ] && [ -t 1 ]; then
    _install_tui
    exec python3 "$TUI_PATH"
  else
    dispatch "yardim"
  fi
else
  dispatch "$1" "${@:2}"
fi
